<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvEstadoJornada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jornada abierta"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen del día"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="16dp"/>

        <!-- Alerta de stock -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlertaStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFF3E0"
            app:strokeColor="#FF9800"
            app:strokeWidth="1dp">
            <TextView
                android:id="@+id/tvAlertaStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="#E65100"
                android:visibility="gone"
                android:drawablePadding="8dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de indicadores -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ventas" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                        <TextView android:id="@+id/tvTotalIngresos"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="$0" android:textSize="18sp" android:textStyle="bold"
                            android:textColor="@color/texto_principal"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Costos" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                        <TextView android:id="@+id/tvTotalCostos"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="$0" android:textSize="18sp" android:textStyle="bold"
                            android:textColor="@color/texto_principal"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gastos" android:textSize="12sp" android:textColor="@color/texto_secundario"/>
                        <TextView android:id="@+id/tvTotalGastos"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="$0" android:textSize="18sp" android:textStyle="bold"
                            android:textColor="@color/texto_principal"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#EEEEEE" android:layout_marginBottom="12dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ganancia neta del día" android:textSize="13sp"
                    android:textColor="@color/texto_secundario"/>

                <TextView android:id="@+id/tvGananciaNeta"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="$0" android:textSize="32sp" android:textStyle="bold"
                    android:textColor="@color/ganancia_positiva"
                    android:layout_marginBottom="12dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Progreso hacia la meta" android:textSize="12sp"
                    android:textColor="@color/texto_secundario"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <ProgressBar android:id="@+id/progressBarMeta"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="12dp"
                        android:layout_weight="1" android:max="100" android:progress="0"
                        android:progressTint="@color/colorPrimary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tvProgresoPorcentaje"
                        android:layout_width="40dp" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="12sp"
                        android:textColor="@color/colorPrimary" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de acción -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarVenta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ Registrar venta"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarGasto"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Registrar gasto del día"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarJornada"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver resumen y cerrar jornada"
            android:textSize="15sp"/>

    </LinearLayout>
</ScrollView>
