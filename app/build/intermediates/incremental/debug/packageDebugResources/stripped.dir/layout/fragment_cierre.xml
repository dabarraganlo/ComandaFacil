<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cierre de jornada"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvFechaJornada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/texto_secundario"
            android:layout_marginBottom="16dp"/>

        <!-- Tarjeta de resumen -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Total ventas"
                        android:textColor="@color/texto_secundario"/>
                    <TextView android:id="@+id/tvIngresos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="$0" android:textStyle="bold" android:textColor="@color/texto_principal"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Costos de producción"
                        android:textColor="@color/texto_secundario"/>
                    <TextView android:id="@+id/tvCostos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="$0" android:textStyle="bold" android:textColor="@color/texto_principal"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Gastos del día"
                        android:textColor="@color/texto_secundario"/>
                    <TextView android:id="@+id/tvGastos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="$0" android:textStyle="bold" android:textColor="@color/texto_principal"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#EEEEEE" android:layout_marginBottom="12dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Lo que ganaste hoy" android:textSize="13sp"
                    android:textColor="@color/texto_secundario"/>

                <TextView android:id="@+id/tvGananciaNeta"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="$0" android:textSize="36sp" android:textStyle="bold"
                    android:textColor="@color/ganancia_positiva" android:layout_marginBottom="4dp"/>

                <TextView android:id="@+id/tvMargenReal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="@color/texto_secundario"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ProgressBar android:id="@+id/progressBarCierre"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp" android:layout_height="12dp"
                        android:layout_weight="1" android:max="100"
                        android:progressTint="@color/colorPrimary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tvProgresoCierre"
                        android:layout_width="40dp" android:layout_height="wrap_content"
                        android:text="0%" android:textSize="12sp"
                        android:textColor="@color/colorPrimary" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mensaje motivacional -->
        <TextView android:id="@+id/tvMensajeMeta"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="14dp" android:textSize="14sp" android:gravity="center"
            android:background="#E8F5E9" android:layout_marginBottom="16dp"
            android:textColor="#2E7D32" android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarJornada"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Cerrar jornada"
            android:textSize="15sp"
            android:layout_marginBottom="24dp"/>

        <!-- Historial -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Jornadas anteriores" android:textSize="16sp"
            android:textStyle="bold" android:textColor="@color/texto_principal"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
