<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_app"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar venta"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/texto_principal"
        android:layout_marginBottom="16dp"/>

    <!-- Campo 1: Seleccionar producto -->
    <TextView
        android:id="@+id/tvAyudaProducto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué vendiste?"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerProducto"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/spinner_background"
        android:layout_marginBottom="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="12dp">
        <TextView android:id="@+id/tvCostoProducto"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp"
            android:textColor="@color/texto_secundario"/>
        <TextView android:id="@+id/tvGananciaEstimada"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp"
            android:textColor="@color/ganancia_positiva"
            android:gravity="end"/>
    </LinearLayout>

    <!-- Campo 2: Cantidad -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="¿Cuántas unidades vendiste?"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="1"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo 3: Precio de venta -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="¿A cuánto lo vendiste? (precio sugerido pre-llenado)"
        android:layout_marginBottom="20dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrecioVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ventas del día -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegistrarVenta"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="20dp"
        android:text="Registrar venta"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvConteoVentas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 ventas registradas hoy"
        android:textSize="13sp"
        android:textColor="@color/texto_secundario"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVentasHoy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
